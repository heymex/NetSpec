# NetSpec Environment Configuration
# Copy this file to .env and update with your actual values
#
# Komodo / Portainer / Dockge: place this next to docker-compose.yml in the project
# directory (repo checkout). See README: "Komodo, Portainer, and similar UIs".

# =============================================================================
# SNMP Settings
# =============================================================================
# SNMPv2c community (confirmation in telemetry_ingest_push; primary polling in snmp_validate_only)
SNMP_COMMUNITY=public

# =============================================================================
# NetSpec Container Image
# =============================================================================
# Pin a release for reproducible deploys (see CHANGELOG.md / docs/RELEASE_NOTES.md).
# Examples: v2.0.0, v2.0.0-beta.3, v2.0.0-beta.2, v2.0.0-beta.1, v1.0.0, latest
NETSPEC_IMAGE_TAG=latest

# =============================================================================
# NetSpec Application Settings
# =============================================================================
# Pin runtime config/data root so compose mounts never fall back unexpectedly.
# Keep this aligned with where your host stores config/, data/, apprise-config/.
NETSPEC_DATA_DIR=/opt/netspec

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Optional web UI/API port override (default in app: 8088)
API_PORT=8088

# Push ingest target for the Go MDT sidecar (must match global.ingest.port).
# Preferred for fan-out testing: comma-separated host:port list.
# Example:
# NETSPEC_INGEST_TARGETS=10.10.199.38:57501,10.10.199.36:57501
# When NETSPEC_INGEST_TARGETS is set, NETSPEC_INGEST_HOST/PORT are ignored.
NETSPEC_INGEST_TARGETS=
#
# Single-target fallback. With bridge networking, netspec-mdt reaches netspec via Docker DNS.
NETSPEC_INGEST_HOST=netspec-netspec
NETSPEC_INGEST_PORT=57500

# Optional allowlist (comma-separated) for netspec-mdt.
# Leave empty to forward all telemetry sources.
# Example: MDT_ALLOWED_DEVICES=asw-at205-01,csw-mcd-01,dsw-heintz-01
MDT_ALLOWED_DEVICES=
MDT_RESEND_INTERVAL=60s

# netspec-mdt sidecar HTTP: /health, /stats (JSON), /metrics (Prometheus).
# Set NETSPEC_MDT_METRICS_ADDR=off to disable. Host publish uses NETSPEC_MDT_METRICS_PORT.
NETSPEC_MDT_METRICS_ADDR=0.0.0.0:8089
NETSPEC_MDT_METRICS_PORT=8089

# Optional VictoriaMetrics write for NetSpecGraph (Influx line protocol).
# Empty disables (default compose). Graph stack:
#   MDT_VM_URL=http://netspec-victoriametrics:8428
MDT_VM_URL=
MDT_VM_DATABASE=netspecgraph

# =============================================================================
# Authentication
# =============================================================================
# Authentication is disabled when NETSPEC_ADMIN_PASSWORD_HASH is unset (open access).
# To enable, generate a bcrypt hash and set it here:
#   docker run --rm ghcr.io/heymex/netspec:latest hash-password
#   (or: netspec hash-password)
# Then paste the output below.
NETSPEC_ADMIN_PASSWORD_HASH=

# Optional bearer token for API/script access (Authorization: Bearer <token>).
# Allows programmatic access alongside the session cookie used by the web UI.
# NETSPEC_API_TOKEN=

# =============================================================================
# TLS/HTTPS Configuration
# =============================================================================
# STRONGLY RECOMMENDED: Configure TLS to encrypt all traffic including passwords,
# session cookies, API tokens, SNMP communities, and administrative requests.
#
# Provide paths to your TLS certificate and private key files.
# These can be generated using:
#   - Let's Encrypt (certbot)
#   - Self-signed certificates (openssl)
#   - Your organization's PKI
#
# Example with Let's Encrypt:
#   TLS_CERT_PATH=/etc/letsencrypt/live/netspec.example.com/fullchain.pem
#   TLS_KEY_PATH=/etc/letsencrypt/live/netspec.example.com/privkey.pem
#
# Example with self-signed certificate (for testing only):
#   openssl req -x509 -newkey rsa:4096 -nodes \
#     -keyout /opt/netspec/tls/server.key \
#     -out /opt/netspec/tls/server.crt \
#     -days 365 -subj "/CN=netspec.local"
#   TLS_CERT_PATH=/opt/netspec/tls/server.crt
#   TLS_KEY_PATH=/opt/netspec/tls/server.key
#
# If these are not set, the server will run over HTTP (plaintext).
# WARNING: Without TLS, credentials and sensitive data are transmitted unencrypted.
TLS_CERT_PATH=
TLS_KEY_PATH=

# =============================================================================
# Docker Runtime Limits / Log Rotation
# =============================================================================
# Per-service overrides (all values optional). Defaults shown below prevent
# runaway /var/lib/docker/containers/*-json.log growth on low-activity stacks.
#
# NetSpec API/engine container
NETSPEC_LOG_MAX_SIZE=10m
NETSPEC_LOG_MAX_FILE=5
NETSPEC_MEM_LIMIT=512m
NETSPEC_CPU_LIMIT=1.0
NETSPEC_PIDS_LIMIT=256
#
# Apprise API container
APPRISE_LOG_MAX_SIZE=10m
APPRISE_LOG_MAX_FILE=5
APPRISE_MEM_LIMIT=512m
APPRISE_CPU_LIMIT=1.0
APPRISE_PIDS_LIMIT=256
#
# Go MDT sidecar
MDT_LOG_MAX_SIZE=10m
MDT_LOG_MAX_FILE=5
MDT_MEM_LIMIT=512m
MDT_CPU_LIMIT=1.0
MDT_PIDS_LIMIT=256
#
# Legacy Telegraf + translator (docker-compose.legacy-mdt.yml only)
TELEGRAF_LOG_MAX_SIZE=10m
TELEGRAF_LOG_MAX_FILE=5
TELEGRAF_MEM_LIMIT=512m
TELEGRAF_CPU_LIMIT=1.0
TELEGRAF_PIDS_LIMIT=256
TRANSLATOR_LOG_MAX_SIZE=10m
TRANSLATOR_LOG_MAX_FILE=5
TRANSLATOR_MEM_LIMIT=512m
TRANSLATOR_CPU_LIMIT=1.0
TRANSLATOR_PIDS_LIMIT=256

# =============================================================================
# Apprise Notification Configuration
# =============================================================================
# Base URL of the Apprise-API container (required for NetSpec to send anything).
# With bridge networking, NetSpec reaches Apprise via Docker DNS — no need to
# change this unless you use an external Apprise-API instance.
APPRISE_API_URL=http://netspec-apprise:8000

# Optional: HTTP client timeout for each Apprise-API request (Go duration, default 10s)
# APPRISE_NOTIFY_TIMEOUT=15s

# Values referenced by alerts.channels.*.url_env in config/alerts.yaml.
# Each value is either (a) an Apprise service URL containing "://" or (b) a stored
# notify key configured inside Apprise-API (POST /notify/{key}/).
# Examples:
#   Slack: slack://tokenA/tokenB/tokenC
#   Teams: msteams://TokenA/TokenB/TokenC
#   Email: mailto://user:pass@smtp.example.com
#   OpsGenie: opsgenie://apikey@

# Slack (must match url_env in alerts.yaml, e.g. APPRISE_SLACK_WEBHOOK)
APPRISE_SLACK_WEBHOOK=slack://tokenA/tokenB/tokenC

# Microsoft Teams webhook URL
APPRISE_TEAMS_WEBHOOK=msteams://TokenA/TokenB/TokenC

# Email notification URL
# APPRISE_EMAIL_URL=mailto://user:pass@smtp.example.com

# OpsGenie API URL
# APPRISE_OPSGENIE_URL=opsgenie://apikey@

# =============================================================================
# OpenClaw Webhook Alerts (optional)
# =============================================================================
# Channel type "openclaw" in config/alerts.yaml POSTs structured JSON to an
# OpenClaw Gateway webhook. See docs/OPENCLAW_ALERTING.md.
#
# Full webhook URL (mapped hook recommended), e.g.:
#   http://openclaw-gateway:18789/hooks/netspec
# OPENCLAW_WEBHOOK_URL=
#
# Shared hook token (Authorization: Bearer / x-openclaw-token):
# OPENCLAW_HOOK_TOKEN=
#
# Public base URL for alert/device links embedded in the payload:
# NETSPEC_PUBLIC_URL=https://netspec.example

# =============================================================================
# Optional: Grafana (if using metrics visualization)
# =============================================================================
# Grafana admin password (if using Grafana service)
# GRAFANA_ADMIN_PASSWORD=your-grafana-password
