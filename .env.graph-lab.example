# NetSpecGraph lab stack — copy to .env.graph-lab and adjust.
# Does NOT replace production .env. Use:
#   ./scripts/setup-graph-lab.sh
#   make graph-lab-up
#
# Isolation knobs (required when prod is already on this Docker host):
COMPOSE_PROJECT_NAME=netspecgraphlab
NETSPEC_NAME_PREFIX=netspecgl
NETSPEC_ENV_FILE=.env.graph-lab
NETSPEC_DATA_DIR=/opt/netspec-graphlab

# Build/run Graph from this checkout (feat/netspecgraph), not GHCR latest.
# make graph-lab-up builds via docker-compose.build-local.yml
NETSPEC_IMAGE_TAG=local

# Host ports — must not collide with production (8088 / 8086 / 57500 / 8428 / 8090)
API_PORT=8188
APPRISE_HOST_PORT=8186
MDT_PORT=57510
VM_PORT=18428
GRAPH_PORT=8190

# Bridge-internal ingest (translator → netspec service). Leave at 57500 unless you
# also change global.ingest.port in the lab desired-state.yaml.
NETSPEC_INGEST_HOST=netspec-netspec
NETSPEC_INGEST_PORT=57500
APPRISE_API_URL=http://netspec-apprise:8000

SNMP_COMMUNITY=public
LOG_LEVEL=info
GRAPH_TIMEZONE=America/Chicago
GRAPH_VM_URL=http://netspec-victoriametrics:8428

# Lab usually should not page anyone. Leave channels empty / unset webhooks,
# or point alerts.yaml at a discard sink.
# NETSPEC_ADMIN_PASSWORD_HASH=
# NETSPEC_API_TOKEN=

# Optional: only forward a subset of MDT sources into the lab translator
# MDT_ALLOWED_DEVICES=csw-lab-01,asw-lab-01
